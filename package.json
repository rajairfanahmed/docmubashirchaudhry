{
  "name": "countries-learning-platform",
  "version": "1.0.0",
  "description": "Free Material Design learning and self-test quiz platform for world countries, capitals, currencies, and languages.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/validate.ts && tsx scripts/build-static-data.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "validate": "tsx scripts/validate.ts",
    "data:build": "tsx scripts/build-static-data.ts",
    "data:sync-countries": "tsx scripts/sync-countries.ts",
    "data:pdf-manifest": "tsx scripts/pdf-manifest.ts",
    "data:export-csv": "tsx scripts/export-csv.ts",
    "data:import-csv": "tsx scripts/import-csv.ts",
    "check:links": "tsx scripts/check-links.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.9",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.475.0",
    "minisearch": "^7.2.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
