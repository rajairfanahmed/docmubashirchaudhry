# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & coverage
/coverage
/.vitest-cache
/playwright-report
/test-results

# Next.js & build outputs
/.next/
/.next*/
/out/
/build/

# Vercel local state
.vercel

# Environment variables (keep .env.example tracked; never commit real secrets)
.env
.env*.local
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript incremental cache & generated Next env types
*.tsbuildinfo
next-env.d.ts

# OS / Editor files
.DS_Store
Thumbs.db
*.pem

