# Static Content, Sync, Vercel & Brand CDN Configuration (No secret keys in client bundles)
# Never put private/secret API tokens (sk_*, rc_live_*) in .env.example or NEXT_PUBLIC_* env vars.

# Canonical open country dataset sync source (mledoze/countries replaced deprecated restcountries.com v3.1)
COUNTRIES_SYNC_SOURCE_URL=https://raw.githubusercontent.com/mledoze/countries/master/countries.json

# Optional commercial REST Countries v5 endpoint + server-only build key (used only in sync scripts if set)
REST_COUNTRIES_V5_BASE_URL=https://restcountries.com/v5
REST_COUNTRIES_V5_API_KEY=

# Publishable Logo.dev CDN token for public image tags (domain-restricted public key)
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=pk_e4a3hiZuS9GaAmHepVmkcw
LOGO_DEV_CDN_BASE_URL=https://img.logo.dev

# Canonical Site Origin (set on Vercel once the deployment domain is assigned, then pass URL to /seo)
# When unset locally, falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL on Vercel or https://docmubashirchaudhary.com
NEXT_PUBLIC_SITE_URL=
SITE_CANONICAL_URL=https://docmubashirchaudhary.com
