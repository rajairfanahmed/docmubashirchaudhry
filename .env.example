# ============================================================================
# docmubashirchaudhry (v3.0) - Environment Variable Template (NO SECRETS HERE)
# Copy values into untracked .env.local and Vercel Project Environment Variables.
#
# Architecture Summary:
# 1. Clerk: Identity Provider (owns signup, signin, sessions, OAuth, password reset).
# 2. Supabase: PostgreSQL Database ONLY (stores quiz attempts, pdf access logs, profiles).
#    No auth credentials or auth tables are stored in Supabase. Keyed by clerk_user_id.
# 3. Cloudflare R2: Object Storage for private, watermarked PDF booklets.
# ============================================================================

# --- Clerk Authentication (Required for Auth) ---
# Get keys from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks -> Add Endpoint -> Signing Secret)
CLERK_WEBHOOK_SECRET=whsec_replace_me

# --- Supabase Database (PostgreSQL data layer only) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only privileged secret key (never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_replace_me

# --- Admin Allow-List (Required for /admin and /api/admin/*) ---
# Comma-separated lowercase owner email(s)
ADMIN_EMAILS=owner@example.com

# --- Cloudflare R2 Private Bucket (Server-only S3 API) ---
# S3 API endpoint derived as https://<CLOUDFLARE_R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Keep Public R2.dev Access DISABLED in Cloudflare Dashboard so PDFs stay private.
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=docmubashirchaudhary
CLOUDFLARE_R2_SIGNED_URL_TTL_SECONDS=180

# --- Canonical Site Origin ---
NEXT_PUBLIC_SITE_URL=https://docmubashirchaudhry.vercel.app
SITE_CANONICAL_URL=https://docmubashirchaudhry.vercel.app

# --- Legacy / Static Sync & Brand CDN Configuration (v2.0 carried forward) ---
COUNTRIES_SYNC_SOURCE_URL=https://raw.githubusercontent.com/mledoze/countries/master/countries.json
REST_COUNTRIES_V5_BASE_URL=https://restcountries.com/v5
REST_COUNTRIES_V5_API_KEY=
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=pk_e4a3hiZuS9GaAmHepVmkcw
LOGO_DEV_CDN_BASE_URL=https://img.logo.dev
